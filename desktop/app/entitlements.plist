<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened Runtime exceptions the ONNX Runtime / CoreML dylibs may need. NOT yet tested with a
       real signing identity: if the notarised app fails to start, check Console.app for a
       "code signature invalid" / library-validation message and trim or extend this list. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- live mode: system audio capture (also covers the audio-input TCC check under the hardened runtime) -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
